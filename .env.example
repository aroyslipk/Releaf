# Application Configuration
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Database Configuration (PostgreSQL for production)
DATABASE_URL=postgresql://username:password@host:5432/releaf_db
SPRING_DATASOURCE_URL=${DATABASE_URL}
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# JPA/Hibernate Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Application Base URL
APP_BASE_URL=https://your-app-name.railway.app

# Email Configuration (Optional)
MAIL_USERNAME=your-email@outlook.com
MAIL_PASSWORD=your-email-password
MAIL_HOST=smtp-mail.outlook.com
MAIL_PORT=587

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5MB

# Security (Optional - for production hardening)
# JWT_SECRET=your-secret-key-here
# SESSION_TIMEOUT=3600

# Notes:
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env file to version control
# 3. For Railway/Render, set these as environment variables in the dashboard
# 4. DATABASE_URL is automatically provided by Railway/Render when you add PostgreSQL
